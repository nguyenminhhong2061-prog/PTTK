# =============================================
# Environment Variables Template
# Copy this file to .env and provide real values.
# =============================================

# --- General ---
COMPOSE_PROJECT_NAME=quiz-system
ENVIRONMENT=development

# --- Database (MySQL) ---
DB_USER=root
DB_PASSWORD=changeme

# --- Service Ports (host) ---
EXAM_SERVICE_PORT=5001
SUBMISSION_SERVICE_PORT=5002
STATISTICS_SERVICE_PORT=5003
GATEWAY_PORT=8080
FRONTEND_PORT=3000

# --- Database Ports (host) ---
EXAM_DB_PORT=3306
SUBMISSION_DB_PORT=3307
STATISTICS_DB_PORT=3309

# --- RabbitMQ ---
RABBITMQ_USER=admin
RABBITMQ_PASS=changeme
RABBITMQ_AMQP_PORT=5672
RABBITMQ_UI_PORT=15672
RABBITMQ_EXCHANGE=quiz.events
RABBITMQ_QUEUE=statistics.exam-submitted
RABBITMQ_ROUTING_KEY=exam.submitted
RABBITMQ_DLQ=statistics.exam-submitted.dlq

# JWT_SECRET=your-jwt-secret
